{
  "name": "pi-ticket-dispatcher",
  "version": "0.1.0",
  "description": "A Pi package that dispatches tickets to Herdr-managed Pi workers for implementation, review, and integration.",
  "keywords": ["pi-package"],
  "type": "module",
  "main": "./extensions/ticket-dispatch/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "test:integration": "node test/integration.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": ["./extensions/ticket-dispatch/index.ts"],
    "skills": ["./skills"]
  }
}
